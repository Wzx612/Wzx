# ============================================================================
# Atlas — environment template
#
#   cp .env.example .env          # then edit values
#
# This file documents EVERY variable the docker compose stack understands.
# Infrastructure credentials here have safe defaults baked into docker-compose
# (so the stack runs even without a .env). Application SECRETS live in
# ./backend/.env (see ./backend/.env.example) and are loaded via env_file.
# ============================================================================

# ── Application secrets (REQUIRED) ──────────────────────────────────────────
# Put these in ./backend/.env — they are loaded into the app containers.
#   DASHSCOPE_API_KEY=sk-...        # Qwen-VL-Max (image analysis / OCR)
#   DEEPSEEK_API_KEY=sk-...         # DeepSeek (RAG answer generation)

# ── PostgreSQL (pgvector) ───────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres        # CHANGE in production
POSTGRES_DB=atlas
POSTGRES_PORT=5432

# ── Redis (query-embedding cache) ───────────────────────────────────────────
REDIS_PORT=6379

# ── MinIO (object storage) ──────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin    # CHANGE in production
MINIO_BUCKET=atlas-images
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Gateway ─────────────────────────────────────────────────────────────────
HTTP_PORT=80

# ── Application tuning (optional; defaults shown) ────────────────────────────
# These are normally set per-service by docker-compose; override only if needed.
#   EMBEDDING_SERVICE_URL=http://embedding-service:8000  # set on rag/agent only
#   EMBEDDING_HTTP_TIMEOUT=180
#   EMBEDDING_CACHE_TTL=86400
#   MAX_FILE_SIZE_MB=10
#   RATE_LIMIT_PER_MINUTE=20

# ── Frontend (build-time, Vite) ─────────────────────────────────────────────
# The SPA is served as static files by nginx and talks to the gateway at /api.
# Rebuild the frontend (npm run build) with VITE_API_BASE=/api to use this stack.
VITE_API_BASE=/api
VITE_CLAUDE_API_KEY=
VITE_DEEPSEEK_API_KEY=
VITE_TAVILY_API_KEY=
