# ── Node / frontend ──────────────────────────────────────────────────────
node_modules
dist
dist-ssr
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json
*.tsbuildinfo

# ── Secrets ──────────────────────────────────────────────────────────────
# Never commit real env files. Example/template files ARE tracked.
.env
.env.*
.env.prod
!.env.example
!.env.prod.example

# ── Python / backend ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# ── Models / caches ──────────────────────────────────────────────────────
# NOTE: do NOT add a bare "models/" here — it would also ignore the Python
# package backend/app/models/. The ML model cache lives in a Docker volume,
# not in the repo, so only the HF download cache needs ignoring.
.hf/

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
