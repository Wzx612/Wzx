# ============================================================================
# Atlas — logrotate (install to /etc/logrotate.d/atlas)
#
# NOTE: Docker container logs are already rotated by the json-file driver
# (max-size/max-file in /etc/docker/daemon.json + per-service logging config),
# so they are NOT handled here. This rotates HOST nginx logs and Atlas op logs.
# ============================================================================

/var/log/nginx/atlas-*.log {
    daily
    rotate 14
    missingok
    compress
    delaycompress
    notifempty
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 "$(cat /var/run/nginx.pid)" || true
    endscript
}

/var/log/atlas/*.log {
    weekly
    rotate 8
    missingok
    compress
    notifempty
    copytruncate
}

# Archived error logs (produced by deploy/archive-errors.sh).
/var/log/atlas/errors/*.log {
    monthly
    rotate 12
    missingok
    compress
    notifempty
}
