# ── Atlas gateway image: built SPA + nginx routing, baked for immutable deploy ─
# Stage 1 builds the Vite SPA; stage 2 bundles it with the gateway nginx.conf.
# Build context = repo root.

FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# API base for the SPA — same-origin /api by default (works behind api.* too).
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

FROM nginx:1.27-alpine
# Gateway routing config (path-based fan-out to the three app services).
COPY nginx.conf /etc/nginx/nginx.conf
# Static SPA.
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
# Use 127.0.0.1 (not "localhost"): inside the container busybox wget resolves
# "localhost" to ::1 first, but nginx listens on IPv4 only, so the probe would
# be refused and the container would stay perpetually unhealthy.
HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
    CMD wget -qO- http://127.0.0.1/healthz || exit 1
