# ============================================================================
# Atlas — PRODUCTION environment (server-side)
#
# On the server:  cp .env.prod.example .env   (in the deploy directory)
# Loaded by docker compose for variable substitution. App SECRETS additionally
# live in ./backend/.env (loaded via env_file).
# ============================================================================

# ── Container registry (set/overridden by CI) ───────────────────────────────
# GHCR: ghcr.io/<owner>/atlas-backend   ·   Docker Hub: docker.io/<user>/atlas-backend
REGISTRY_IMAGE=ghcr.io/owner/atlas-backend
IMAGE_TAG=latest

# ── Domains / CORS ──────────────────────────────────────────────────────────
DOMAIN=example.com
WWW_DOMAIN=www.example.com
API_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com
# CORS allow-list for the API (the SPA origins):
ALLOWED_ORIGINS=https://www.example.com,https://example.com

# ── Gateway (container nginx, bound to loopback; host nginx fronts TLS) ──────
GATEWAY_PORT=8080

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=atlas

# ── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=atlas_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password
MINIO_BUCKET=atlas-images

# ── App tuning ──────────────────────────────────────────────────────────────
RAG_WORKERS=2
AGENT_WORKERS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Monitoring (Grafana) ────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_strong_password
GRAFANA_ROOT_URL=https://grafana.example.com

# ── Backups ─────────────────────────────────────────────────────────────────
BACKUP_DIR=/opt/atlas/backups
BACKUP_RETENTION_DAYS=7
